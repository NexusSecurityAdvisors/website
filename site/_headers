# Turnstile's iframe (challenges.cloudflare.com) doesn't send COEP/CORP, so the two pages that
# embed it opt out. credentialless elsewhere: cross-origin no-cors loads (Thinkers360 badges,
# Cloudflare's beacon) go without cookies instead of needing a CORP header.
/get-started
  ! Cross-Origin-Embedder-Policy
/get-started.html
  ! Cross-Origin-Embedder-Policy
/readiness-check
  ! Cross-Origin-Embedder-Policy
/readiness-check.html
  ! Cross-Origin-Embedder-Policy

# Content-hashed bundles: cache for a year. analytics.js and readiness-check.js keep fixed names but
# every script tag carries ?v=<content hash> (tools/stamp_assets.py, enforced by check_site.py).
/js/*
  Cache-Control: public, max-age=31536000, immutable

# Content-hashed stylesheets (tools/externalise_styles.py and tools/bundle_styles.py name them by hash).
/css/*
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Content-hashed images (name-<sha256[:10]>.webp), e.g. the responsive logo set. Detaches the
# /*.webp one-day rule above (detach only applies to earlier rules) so the two Cache-Control values don't stack.
/img/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/*.pdf
  Cache-Control: public, max-age=86400
/*.docx
  Cache-Control: public, max-age=86400
/*.xlsx
  Cache-Control: public, max-age=86400

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
/security.txt
  Content-Type: text/plain; charset=utf-8

# Staging Worker hostname (infra #20): keep it out of search results until it is removed.
https://stage.nexussecurityadvisors.com/*
  X-Robots-Tag: noindex, nofollow

# Keep *.pages.dev copies out of search results (canonical host is www).
https://:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow

/*.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/llms.txt
