  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://static.cloudflareinsights.com https://*.posthog.com https://*.hs-scripts.com https://*.hs-analytics.net https://*.hs-banner.com https://*.hscollectedforms.net https://*.usemessages.com https://*.hubspot.com; style-src 'self'; img-src 'self' data: https://www.thinkers360.com https://*.hubspot.com https://*.hsforms.com https://*.hs-analytics.net https://*.hs-banner.com; font-src 'self'; connect-src 'self' https://challenges.cloudflare.com https://cloudflareinsights.com https://*.posthog.com https://*.hubspot.com https://*.hubapi.com https://*.hs-banner.com https://*.hscollectedforms.net https://*.hsforms.com https://*.hs-analytics.net https://*.usemessages.com; frame-src https://*.hubspot.com https://challenges.cloudflare.com; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests; report-uri https://www.nexussecurityadvisors.com/csp-report; report-to csp
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://static.cloudflareinsights.com https://*.hs-scripts.com https://*.hs-analytics.net https://*.hs-banner.com https://*.hscollectedforms.net https://*.usemessages.com https://*.hubspot.com; style-src 'self'; img-src 'self' data: https://www.thinkers360.com https://*.hubspot.com https://*.hsforms.com https://*.hs-analytics.net https://*.hs-banner.com; font-src 'self'; connect-src 'self' https://challenges.cloudflare.com https://cloudflareinsights.com https://us.posthog.com https://*.hubspot.com https://*.hubapi.com https://*.hs-banner.com https://*.hscollectedforms.net https://*.hsforms.com https://*.hs-analytics.net https://*.usemessages.com; frame-src https://*.hubspot.com https://challenges.cloudflare.com; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; report-uri https://www.nexussecurityadvisors.com/csp-report https://us.i.posthog.com/report/?token=phc_DuzGMcGgYX9NfaIQr0gtNWEDi2dmQr5kZr4CwxgUJA2&v=ro-1; report-to posthog
  Reporting-Endpoints: csp="https://www.nexussecurityadvisors.com/csp-report", posthog="https://us.i.posthog.com/report/?token=phc_DuzGMcGgYX9NfaIQr0gtNWEDi2dmQr5kZr4CwxgUJA2&v=ro-1"
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless
  X-Permitted-Cross-Domain-Policies: none
  Cross-Origin-Resource-Policy: same-origin
  ! Access-Control-Allow-Origin

# Turnstile's iframe (challenges.cloudflare.com) doesn't send COEP/CORP, so the two pages that
# embed it opt out. credentialless elsewhere: cross-origin no-cors loads (Thinkers360 badges,
# Cloudflare's beacon) go without cookies instead of needing a CORP header.
/get-started
  ! Cross-Origin-Embedder-Policy
/get-started.html
  ! Cross-Origin-Embedder-Policy
/readiness-check
  ! Cross-Origin-Embedder-Policy
/readiness-check.html
  ! Cross-Origin-Embedder-Policy

# Content-hashed bundles: cache for a year. analytics.js and readiness-check.js keep fixed names but
# every script tag carries ?v=<content hash> (tools/stamp_assets.py, enforced by check_site.py).
/js/*
  Cache-Control: public, max-age=31536000, immutable

# Content-hashed stylesheets (tools/externalise_styles.py and tools/bundle_styles.py name them by hash).
/css/*
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Content-hashed images (name-<sha256[:10]>.webp), e.g. the responsive logo set. Detaches the
# /*.webp one-day rule above (detach only applies to earlier rules) so the two Cache-Control values don't stack.
/img/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/*.pdf
  Cache-Control: public, max-age=86400
/*.docx
  Cache-Control: public, max-age=86400
/*.xlsx
  Cache-Control: public, max-age=86400

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
/security.txt
  Content-Type: text/plain; charset=utf-8

# Staging Worker hostname (infra #20): keep it out of search results until it is removed.
https://stage.nexussecurityadvisors.com/*
  X-Robots-Tag: noindex, nofollow

# Keep *.pages.dev copies out of search results (canonical host is www).
https://:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow

/*.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/llms.txt
  Content-Type: text/plain; charset=utf-8
